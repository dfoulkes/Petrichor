# Golden Shower — ESPHome secrets TEMPLATE
# ---------------------------------------------------------------------------
# Copy this file to `secrets.yaml` (same folder) and fill in real values:
#     cp secrets.yaml.example secrets.yaml
# `secrets.yaml` is git-ignored — never commit your real credentials.
#
# Generate the API + OTA keys with:
#     openssl rand -base64 32     # for api_encryption_key
#     openssl rand -base64 18     # a decent ota/ap password
# ---------------------------------------------------------------------------

# Key names below MATCH your Infisical folder (homelab / prod / /GoldenShower)
# so `infisical export --format yaml` drops straight in with no remapping.
wifi_base_station_name: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot the board raises if it can't reach your Wi-Fi (min 8 chars)
ap_password: "change-me-8chars-min"

# 32-byte base64 key — HA uses this to talk to the device securely
api_encryption_key: "PASTE_openssl_rand_base64_32_HERE"

# Password required to push OTA firmware updates over Wi-Fi
ota_password: "change-me-ota-password"
